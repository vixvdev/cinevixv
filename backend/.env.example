# ═══════════════════════════════════════════
# CINEVIXV BACKEND — ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── TikTok Developer Credentials ──
# Get these from https://developers.tiktok.com/ → Manage Apps → Your App
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── TikTok OAuth Redirect URI ──
# MUST match exactly what you set in TikTok Developer Portal
# Format: https://yourdomain.com/api/tiktok/callback
TIKTOK_REDIRECT_URI=https://cine.vixv.biz.id/api/tiktok/callback

# ── Server Configuration ──
PORT=4000
NODE_ENV=development

# ── Session Secret ──
# Generate a strong random string (min 32 chars)
# Run this in Node.js to generate: require('crypto').randomBytes(32).toString('hex')
SESSION_SECRET=

# ── CORS ──
# Your frontend domain (must match exactly)
CORS_ORIGIN=https://cine.vixv.biz.id

# ── Auto-Post Configuration (Optional) ──
# If you want to auto-post videos from CMS to TikTok
# Set this to the TikTok username that will receive posts
TIKTOK_TARGET_USERNAME=cinevix

# ── Logging ──
LOG_LEVEL=info
